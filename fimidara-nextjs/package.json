{
  "name": "fimidara-nextjs",
  "version": "1.0.0",
  "description": "fimidara file storage service Next.js frontend",
  "author": {
    "email": "ywordk@gmail.com",
    "name": "softkave"
  },
  "license": "MIT",
  "keywords": [],
  "private": true,
  "type": "module",
  "scripts": {
    "start": "next start -p $PORT",
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "db:generate": "npx --yes -- softkave-forerunner@latest run-env --cmd \"npx drizzle-kit generate\"",
    "db:migrate": "npx --yes -- softkave-forerunner@latest run-env --cmd \"npx drizzle-kit migrate\"",
    "db:migrate-sqlite-to-postgres": "npx tsx scripts/db/migrate-sqlite-to-postgres.ts",
    "postgres:start": "npx --yes -- softkave-forerunner@latest run-env -e .env.local --cmd 'softkave-forerunner postgres start --version 16 --port $PG_PORT --container-name $PG_CONTAINER_NAME --user $PG_USER --password $PG_PASSWORD --keep'",
    "postgres:ensure-dbs": "npx --yes -- softkave-forerunner@latest run-env -e .env.local --cmd 'bash scripts/db/ensure-postgres-dbs.sh'",
    "upload-source-maps": "npx --yes -- fimidx@latest source-maps upload --client-token \"$FIMIDX_SYMBOLICATION_AUTH_TOKEN\" --project-id \"$NEXT_PUBLIC_FIMIDX_LOGGER_PROJECT_ID\" --repo \"$NEXT_PUBLIC_FIMIDX_SYMBOLICATION_REPO\" --version \"$NEXT_PUBLIC_FIMIDX_SYMBOLICATION_VERSION\" --path .next",
    "delete-source-maps": "find .next -name '*.map' -type f -delete"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.3",
    "@auth/drizzle-adapter": "^1.7.3",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^3.9.0",
    "@libsql/client": "^0.14.0",
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next/bundle-analyzer": "^13.3.1",
    "@next/mdx": "^14.2.5",
    "@types/mdx": "^2.0.13",
    "@types/react": "^18.2.58",
    "@types/react-dom": "^18.2.19",
    "ahooks": "^3.7.7",
    "assert": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "core-js": "^3.21.1",
    "date-fns": "^2.30.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.2",
    "fimidara": "^1.41.1",
    "fimidara-private-js-sdk": "workspace:*",
    "fimidx": "^0.8.0",
    "immer": "^10.0.3",
    "isomorphic-form-data": "^2.0.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.544.0",
    "mfdoc": "^0.4.0",
    "next": "^15.5.15",
    "next-auth": "^5.0.0-beta.25",
    "next-mdx-remote": "^5.0.0",
    "nextjs-toploader": "^1.6.12",
    "path-browserify": "^1.0.1",
    "pg": "^8.13.3",
    "pretty-bytes": "^6.0.0",
    "rc-upload": "^4.9.2",
    "react": "^18.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.53.0",
    "react-icons": "^5.4.0",
    "shadcn": "^4.21.0",
    "softkave-js-utils": "^0.10.0",
    "softkave-node-utils": "^0.8.0",
    "swr": "^2.3.2",
    "tailwind-merge": "^3.6.0",
    "type-fest": "^4.26.1",
    "uuid": "^11.0.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/fs-extra": "^11.0.1",
    "@types/isomorphic-form-data": "^2.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/path-browserify": "^1.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "drizzle-kit": "^0.28.1",
    "env-cmd": "^10.1.0",
    "eslint": "^8.42.0",
    "eslint-config-next": "14.2.5",
    "fs-extra": "^11.1.1",
    "next-compose-plugins": "^2.2.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.1.3"
  }
}
