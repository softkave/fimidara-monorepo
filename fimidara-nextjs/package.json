{
  "name": "fimidara-nextjs",
  "version": "1.0.0",
  "description": "fimidara file storage service Next.js frontend",
  "author": {
    "email": "ywordk@gmail.com",
    "name": "softkave"
  },
  "license": "MIT",
  "keywords": [],
  "private": true,
  "type": "module",
  "scripts": {
    "start": "next start -p $PORT",
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "db:generate": "npx --yes -- softkave-forerunner@latest run-env --cmd \"npx drizzle-kit generate\"",
    "db:migrate": "npx --yes -- softkave-forerunner@latest run-env --cmd \"npx drizzle-kit migrate\"",
    "db:migrate-sqlite-to-postgres": "npx tsx scripts/db/migrate-sqlite-to-postgres.ts",
    "postgres:start": "npx --yes -- softkave-forerunner@latest run-env -e .env.local --cmd 'softkave-forerunner postgres start --version 18 --port $PG_PORT --container-name $PG_CONTAINER_NAME --user $PG_USER --password $PG_PASSWORD --keep'",
    "postgres:ensure-dbs": "npx --yes -- softkave-forerunner@latest run-env -e .env.local --cmd 'bash scripts/db/ensure-postgres-dbs.sh'",
    "upload-source-maps": "npx --yes -- fimidx@latest source-maps upload --client-token \"$FIMIDX_SYMBOLICATION_AUTH_TOKEN\" --project-id \"$NEXT_PUBLIC_FIMIDX_LOGGER_PROJECT_ID\" --repo \"$NEXT_PUBLIC_FIMIDX_SYMBOLICATION_REPO\" --version \"$NEXT_PUBLIC_FIMIDX_SYMBOLICATION_VERSION\" --path .next",
    "delete-source-maps": "find .next -name '*.map' -type f -delete"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@libsql/client": "^0.14.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/bundle-analyzer": "^16.3.6",
    "@next/mdx": "^16.3.6",
    "@types/mdx": "^2.0.14",
    "ahooks": "^3.10.0",
    "assert": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "core-js": "^3.50.0",
    "date-fns": "^2.30.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.36.4",
    "fimidara": "^1.41.1",
    "fimidara-private-js-sdk": "workspace:*",
    "fimidx": "^0.9.0",
    "immer": "^10.2.0",
    "isomorphic-form-data": "^2.0.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.47.0",
    "mfdoc": "^0.4.1",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "nextjs-toploader": "^3.9.17",
    "path-browserify": "^1.0.1",
    "pg": "^8.23.0",
    "pretty-bytes": "^7.1.3",
    "rc-upload": "^4.11.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.7.0",
    "shadcn": "^4.21.0",
    "softkave-js-utils": "^0.10.0",
    "softkave-node-utils": "^0.8.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "type-fest": "^4.41.0",
    "uuid": "^11.1.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/isomorphic-form-data": "^2.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.43",
    "@types/path-browserify": "^1.0.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.28.1",
    "env-cmd": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.6",
    "fs-extra": "^11.4.0",
    "next-compose-plugins": "^2.2.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
