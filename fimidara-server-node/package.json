{
  "name": "fimidara-server-node",
  "version": "0.1.0",
  "description": "fimidara file storage service server Node.js",
  "author": {
    "email": "ywordk@gmail.com",
    "name": "softkave"
  },
  "license": "MIT",
  "keywords": [],
  "type": "module",
  "engines": {
    "node": ">=13"
  },
  "scripts": {
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "pnpm clean && tsc",
    "fix": "gts fix",
    "start": "node build/src/index.js",
    "pretest": "tsc",
    "dev": "tsx --env-file=.env.dev src/index.ts",
    "dev:test": "pnpm compile && env-cmd -f \".env.unit-test\" pnpm start",
    "test": "env-cmd -f \".env.unit-test\" vitest run --config ./vitest.config.ts",
    "test:fn": "env-cmd -f \".env.unit-test\" vitest run --config ./vitest.fn.config.ts",
    "test:integration": "env-cmd -f \".env.integration-test\" vitest run --config ./vitest.config.ts",
    "check:circular-deps": "npx dpdm --no-warning --no-tree ./src/index.ts",
    "mongo:local": "npx --yes -- softkave-forerunner@latest run-env --cmd 'softkave-forerunner mongo start --port $MONGO_PORT --container-name $MONGO_CONTAINER_NAME --user $MONGO_USER --password $MONGO_PASSWORD'",
    "render:email-templates": "env-cmd -f \".env.dev\" npx tsx src/tools/email-templates/index.ts",
    "rebuild:usage-records": "npx --yes -- softkave-forerunner@latest run-env --cmd \"tsx src/tools/rebuild-usage-records/index.ts\"",
    "rebuild:usage-records:prod": "npx --yes -- softkave-forerunner@latest run-env -e .env.production --cmd \"tsx src/tools/rebuild-usage-records/index.ts\"",
    "backfill:image-dimensions": "npx --yes -- softkave-forerunner@latest run-env --cmd \"tsx src/tools/backfill-image-dimensions/index.ts\"",
    "summarize:workspace-files": "npx --yes -- softkave-forerunner@latest run-env --cmd \"tsx src/tools/summarize-workspace-files/index.ts\"",
    "gen:public:setup-js-sdk": "mfdoc setup-js-sdk ../fimidara-js-sdk --name fimidara --provider pnpm",
    "gen:public:endpoints-info": "mfdoc gen-http-api-endpoints-info ./src/endpoints/endpoints.mfdoc.ts --output-path ../fimidara-mfdoc-out/public-endpoints --include-tags public --ignore-tags ignoreForEndpointsInfo",
    "gen:public:js-sdk": "mfdoc gen-js-sdk ./src/endpoints/endpoints.mfdoc.ts --output-path ../fimidara-js-sdk --include-tags public --filename-prefix public --ignore-tags ignoreForJsSdk",
    "gen:private:setup-js-sdk": "mfdoc setup-js-sdk ../fimidara-private-js-sdk --name fimidara-private --provider pnpm",
    "gen:private:endpoints-info": "mfdoc gen-http-api-endpoints-info ./src/endpoints/endpoints.mfdoc.ts --output-path ../fimidara-mfdoc-out/private-endpoints --include-tags private --ignore-tags ignoreForEndpointsInfo",
    "gen:private:js-sdk": "mfdoc gen-js-sdk ./src/endpoints/endpoints.mfdoc.ts --output-path ../fimidara-private-js-sdk --include-tags private --filename-prefix private --ignore-tags ignoreForJsSdk",
    "setup:sdk-test:public": "npx env-cmd -f \".env.unit-test\" npx tsx src/tools/sdk-test-setup/index.ts",
    "setup:sdk-test:private": "npx env-cmd -f \".env.unit-test\" npx tsx src/tools/sdk-test-setup/index.ts ../fimidara-private-js-sdk/.env.test",
    "upload-source-maps": "npx --yes -- fimidx@latest source-maps upload --client-token \"$FIMIDX_SYMBOLICATION_AUTH_TOKEN\" --project-id \"$FIMIDX_PROJECT_ID\" --repo \"$FIMIDX_SYMBOLICATION_REPO\" --version \"$FIMIDX_SYMBOLICATION_VERSION\" --path build",
    "delete-source-maps": "find build -name '*.map' -type f -delete"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/client-secrets-manager": "^3.1137.0",
    "@aws-sdk/client-sesv2": "^3.1137.0",
    "@aws-sdk/lib-storage": "^3.1137.0",
    "@sesamecare-oss/redlock": "^1.4.0",
    "argon2": "^0.40.3",
    "busboy": "^1.6.0",
    "commander": "^14.0.3",
    "config": "^3.3.12",
    "cors": "^2.8.6",
    "date-fns": "^2.30.0",
    "express": "^4.22.3",
    "express-jwt": "^8.5.1",
    "fimidx": "^0.9.0",
    "fs-extra": "^11.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^17.13.8",
    "js-accessor": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.18.1",
    "mfdoc": "^0.6.0",
    "mongoose": "8.24.4",
    "nanoid": "^5.1.16",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.28.1",
    "safe-stable-stringify": "^2.5.0",
    "sharp": "^0.35.4",
    "softkave-js-utils": "0.14.0",
    "softkave-node-utils": "^0.8.0",
    "stripe": "^8.222.0",
    "tsyringe": "^4.10.0",
    "type-fest": "^4.41.0",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^3.25.76",
    "zx": "^7.2.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/busboy": "^1.5.4",
    "@types/config": "^3.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/faker": "^5.5.9",
    "@types/fs-extra": "^9.0.13",
    "@types/inquirer": "^8.2.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.4",
    "@types/sharp": "^0.26.1",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^9.2.4",
    "env-cmd": "^10.1.0",
    "expect-type": "^0.19.0",
    "gts": "^5.3.1",
    "inquirer": "^9.3.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
